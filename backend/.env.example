# Environment variables must be supplied to the backend process.
APP_ENV=development
DATABASE_URL=sqlite:///./backend/.data/scortiq.db
# Production requires PostgreSQL and Supabase email authentication.
SUPABASE_URL=
# Public publishable key (or legacy public anon key), never service_role.
SUPABASE_PUBLISHABLE_KEY=
# Use a dedicated Hugging Face endpoint exposing /v1/chat/completions.
HF_ENDPOINT_URL=
HF_TOKEN=
HF_MODEL_ID=scortiq-tutor
DAILY_TUTOR_LIMIT=30
